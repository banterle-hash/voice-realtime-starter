# --- Provider defaults ---
DEFAULT_PROVIDER=openai          # openai | xai

# --- OpenAI ---
OPENAI_API_KEY=sk-...           # get from https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-realtime       # default; change if desired
OPENAI_VOICE=alloy              # alloy | ash | coral | echo | sage | shimmer | verse | ballad

# --- xAI / Grok Voice ---
XAI_API_KEY=xai-...              # get from https://console.x.ai/
XAI_MODEL=grok-voice-latest
XAI_VOICE=eve                   # eve | ara | rex | sal | leo

# --- Twilio (required if you want outbound "Call me") ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1XXXXXXXXXX         # your Twilio phone number (voice-enabled)

# --- ngrok (optional but recommended) ---
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx       # from https://dashboard.ngrok.com/get-started/your-authtoken

# --- App ---
PORT=8080
APP_BASE_URL=                    # leave blank; start script will fill with https://<ngrok>.ngrok-free.app
LOG_LEVEL=info                   # debug | info | warn | error
